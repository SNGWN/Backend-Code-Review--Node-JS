# Dependencies
node_modules/
yarn.lock

# Build output (scoped to dist — keeps jest.config.js / future configs visible)
dist/
dist/**/*.js
dist/**/*.d.ts
dist/**/*.d.ts.map
dist/**/*.js.map

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.github/copilot-instructions.md

# Environment
.env
.env.local
.env.*.local
.env.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Scan reports (per-run outputs the tool writes to cwd by default)
*-report.json
*-report.sarif
*-report.txt
code-review-*.json
code-review-*.sarif
code-review-*.txt
security-report.json
pocs/
bcr-self.sarif

# Testing
.jest
.nyc_output
coverage/
.coverage
tests/generated-phase1-pocs/
tests/fixtures/**/*.js.map

# Misc
.cache
temp/
tmp/
*.tgz
